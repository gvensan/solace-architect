#!/usr/bin/env bash
# Solace Architect uninstall — remove symlinks from ~/.claude/skills/
set -e

CLAUDE_SKILLS_DIR="$HOME/.claude/skills"

if [ ! -d "$CLAUDE_SKILLS_DIR" ]; then
  echo "No skills directory found at $CLAUDE_SKILLS_DIR"
  exit 0
fi

removed=0

# Remove root skill
SA_LINK="$CLAUDE_SKILLS_DIR/solace-architect"
if [ -L "$SA_LINK/SKILL.md" ] || [ -d "$SA_LINK" ]; then
  rm -rf "$SA_LINK"
  echo "  removed: /solace-architect"
  removed=$((removed + 1))
fi

# Remove skill subdirectories (only if managed by solace-architect)
for skill_dir in "$CLAUDE_SKILLS_DIR"/solace-*/; do
  [ -d "$skill_dir" ] || continue
  skill_name="$(basename "$skill_dir")"
  [ "$skill_name" = "solace-architect" ] && continue
  if [ -L "$skill_dir" ]; then
    rm -rf "$skill_dir"
    echo "  removed: /$skill_name"
    removed=$((removed + 1))
  elif [ -L "$skill_dir/SKILL.md" ]; then
    target=$(readlink "$skill_dir/SKILL.md")
    case "$target" in
      *solace-architect*) rm -rf "$skill_dir"
        echo "  removed: /$skill_name"
        removed=$((removed + 1)) ;;
      *) echo "  Skipping $skill_dir (not a solace-architect symlink)" ;;
    esac
  else
    echo "  Skipping $skill_dir (not managed by solace-architect)"
  fi
done

if [ "$removed" -eq 0 ]; then
  echo "No Solace Architect skills found."
else
  echo ""
  echo "Removed $removed skill(s) from $CLAUDE_SKILLS_DIR"
  echo ""
  echo "To reinstall: ./setup"
fi
